# ── SQL Server ───────────────────────────────────────────────────────────────
# Strong password required by SQL Server (uppercase + digit + special char)
SA_PASSWORD=YourStrongPassword123!

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SIGNING_KEY=replace_with_at_least_32_random_characters
JWT_ISSUER=AiAgents.MusicAgent
JWT_AUDIENCE=AiAgents.MusicAgent.Client
JWT_EXPIRY_MINUTES=120

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_TOKEN=replace_with_a_secure_admin_token

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SIGNALR_URL=http://localhost:5000/hubs/analysis
